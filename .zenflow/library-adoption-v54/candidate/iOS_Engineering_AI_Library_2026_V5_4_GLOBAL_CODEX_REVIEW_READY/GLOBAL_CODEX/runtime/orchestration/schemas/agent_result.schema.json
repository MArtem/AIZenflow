{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V5 Agent Result",
  "type": "object",
  "required": [
    "node_id",
    "status",
    "claims",
    "files_inspected",
    "files_changed",
    "commands_run",
    "unknowns",
    "confidence"
  ],
  "properties": {
    "node_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    },
    "claims": {
      "type": "array"
    },
    "files_inspected": {
      "type": "array"
    },
    "files_changed": {
      "type": "array"
    },
    "commands_run": {
      "type": "array"
    },
    "unknowns": {
      "type": "array"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
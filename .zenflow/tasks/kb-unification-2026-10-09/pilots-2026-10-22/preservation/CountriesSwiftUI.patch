+        [.init(name: "KB Retry Country", translations: [:], population: 1, flag: nil, alpha3Code: "KBP")]
+    }
+    func details(country: DBModel.Country) async throws -> ApiModel.CountryDetails {
+        throw ValueIsMissingError()
+    }
+}
+
+private actor KBPilotFailureGate {
+    private var first = true
+    func consume() -> Bool {
+        defer { first = false }
+        return first
+    }
+}
+
+private struct KBPilotDBRepository: CountriesDBRepository {
+    let real: MainDBRepository
+    private let gate = KBPilotFailureGate()
+    init(real: MainDBRepository) { self.real = real }
+    func store(countries: [ApiModel.Country]) async throws {
+        if await gate.consume() { throw KBPilotDatabaseError() }
+        try await real.store(countries: countries)
+    }
+    @MainActor
+    func countryDetails(for country: DBModel.Country) async throws -> DBModel.CountryDetails? {
+        try await real.countryDetails(for: country)
+    }
+    func store(countryDetails: ApiModel.CountryDetails, for country: DBModel.Country) async throws {
+        throw ValueIsMissingError()
+    }
+}
+
+private struct KBPilotDatabaseError: LocalizedError {
+    var errorDescription: String? { "KB database unavailable" }
+}
+
+private struct KBPilotSystemEvents: SystemEventsHandler {
+    let appState: Store<AppState>
+    func sceneOpenURLContexts(_ urlContexts: Set<UIOpenURLContext>) {}
+    func sceneDidBecomeActive() { appState[\.system.isActive] = true }
+    func sceneWillResignActive() { appState[\.system.isActive] = false }
+    func handlePushRegistration(result: Result<Data, Error>) {}
+    func appDidReceiveRemoteNotification(payload: [AnyHashable: Any]) async -> UIBackgroundFetchResult { .noData }
+}
+#endif
diff --git a/KBPilotUITests/CountriesRetryUITests.swift b/KBPilotUITests/CountriesRetryUITests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..219ffa0e6fdb419816b4db3e2908ecbfe9d27c28
--- /dev/null
+++ b/KBPilotUITests/CountriesRetryUITests.swift
@@ -0,0 +1,21 @@
+import XCTest
+
+@MainActor
+final class CountriesRetryUITests: XCTestCase {
+    func testDatabaseFailureRetriesToVisibleCountry() {
+        continueAfterFailure = false
+        let app = XCUIApplication()
+        app.launchArguments = ["-AppleLanguages", "(en)", "-AppleLocale", "en_US"]
+        app.launchEnvironment["COUNTRIES_KB_UI"] = "1"
+        app.launch()
+        defer { app.terminate() }
+        XCTAssertTrue(app.staticTexts["KB database unavailable"].waitForExistence(timeout: 15), app.debugDescription)
+        XCTAssertFalse(app.staticTexts["KB Retry Country"].exists)
+        let retry = app.buttons.matching(NSPredicate(format: "label IN %@", ["Retry", "Повторить", "Повторить попытку"])).firstMatch
+        XCTAssertTrue(retry.waitForExistence(timeout: 10), app.debugDescription)
+        retry.tap()
+        XCTAssertTrue(app.staticTexts["KB Retry Country"].waitForExistence(timeout: 15), app.debugDescription)
+        XCTAssertFalse(app.staticTexts["KB database unavailable"].exists)
+        XCTAssertFalse(retry.exists)
+    }
+}

# Copy to ios-quality/config/project.env and edit after running discover_project.sh.
# Shell-readable runtime configuration for quality scripts.

QUALITY_MODE=STRICT
QUALITY_RISK=R2
QUALITY_TRIGGERS=""

# Set exactly one of QUALITY_WORKSPACE or QUALITY_PROJECT when possible.
QUALITY_WORKSPACE=""
QUALITY_PROJECT=""
QUALITY_SCHEME=""
QUALITY_TEST_PLAN=""
QUALITY_CONFIGURATION="Debug"

# Example: platform=iOS Simulator,name=iPhone 16 Pro,OS=latest
QUALITY_DESTINATION=""

# Optional derived-data folder; if blank scripts use a temporary folder.
QUALITY_DERIVED_DATA=""

# 1 means absence/failure is blocking; 0 means report SKIP when tool is not configured.
QUALITY_REQUIRE_SWIFTLINT=0
QUALITY_REQUIRE_FORMAT_CHECK=0
QUALITY_REQUIRE_FULL_TESTS=0
QUALITY_TREAT_NEW_WARNINGS_AS_FAILURE=1

# Optional project-specific commands override default xcodebuild behavior.
QUALITY_BUILD_COMMAND=""
QUALITY_TARGETED_TEST_COMMAND=""
QUALITY_FULL_TEST_COMMAND=""
QUALITY_LINT_COMMAND=""
QUALITY_FORMAT_COMMAND=""
# Comma- or space-separated identifiers such as AppTests/FeedViewModelTests.
QUALITY_ONLY_TESTING=""
# Optional project-specific sanitizer commands.
QUALITY_TSAN_TEST_COMMAND=""
QUALITY_ASAN_TEST_COMMAND=""

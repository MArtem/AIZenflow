#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if grep -R '^[[:space:]]*\.package(path: "\.\.' Package.swift >/dev/null 2>&1; then
  echo "❌ Sibling path dependency found in Package.swift"
  exit 1
fi

if grep -R "unsafeFlags" Package.swift >/dev/null 2>&1; then
  echo "❌ unsafeFlags found in Package.swift"
  exit 1
fi

if find . \( -name ".DS_Store" -o -name "__MACOSX" -o -name "xcuserdata" \) | grep .; then
  echo "❌ Forbidden generated/metadata files found"
  exit 1
fi

BUILD_DIR="${SWIFTPM_BUILD_PATH:-$(mktemp -d)}"
cleanup_build_dir() {
  if [[ -z "${SWIFTPM_BUILD_PATH:-}" ]]; then
    rm -rf "$BUILD_DIR"
  fi
  rm -rf "$ROOT_DIR/.swiftpm" "$ROOT_DIR/.build"
}
trap cleanup_build_dir EXIT

swift test --build-path "$BUILD_DIR"

if find . \( -name ".build" -o -name ".swiftpm" \) | grep .; then
  echo "❌ Package-local SwiftPM generated state remained after verification"
  exit 1
fi

echo "✅ {{PackageName}} verification passed"
